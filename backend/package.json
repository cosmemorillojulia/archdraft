{
  "name": "@archdraft/api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker with the Archdraft AI agent: creates, edits, improves and redesigns diagrams.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env-file ../.env.defaults --env-file ../.env.secrets",
    "dev:remote": "wrangler dev --env-file ../.env.defaults --env-file ../.env.secrets",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@archdraft/shared": "workspace:*",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "wrangler": "4.151.1"
  }
}
