{
  "name": "@archdraft/web",
  "version": "0.1.0",
  "private": true,
  "description": "Visual editor for cloud architecture diagrams.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-size.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:lighthouse": "pnpm dlx @lhci/cli@0.16.1 autorun"
  },
  "dependencies": {
    "@archdraft/shared": "workspace:*",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.7"
  }
}
