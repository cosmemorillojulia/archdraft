// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toDrawio > exports the three-tier fixture as well formed XML with the expected cells 1`] = `
"<mxfile host="Archdraft">
  <diagram id="archdraft" name="Online store">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n-customer" value="Customer" style="whiteSpace=wrap;html=1;rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-cdn" value="CDN&lt;br&gt;Amazon CloudFront" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-assets" value="Static assets&lt;br&gt;Amazon S3" style="whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-region" value="eu-west-1" style="whiteSpace=wrap;html=1;container=1;collapsible=0;rounded=1;arcSize=4;absoluteArcSize=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-vpc" value="VPC" style="whiteSpace=wrap;html=1;container=1;collapsible=0;rounded=1;arcSize=4;absoluteArcSize=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="n-region">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-public" value="Public subnet" style="whiteSpace=wrap;html=1;container=1;collapsible=0;rounded=1;arcSize=4;absoluteArcSize=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="n-vpc">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-alb" value="ALB&lt;br&gt;Elastic Load Balancing" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="n-public">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-private" value="Private subnet" style="whiteSpace=wrap;html=1;container=1;collapsible=0;rounded=1;arcSize=4;absoluteArcSize=1;dashed=1;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="n-vpc">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-api" value="Store API&lt;br&gt;Amazon ECS" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="n-private">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-db" value="Orders DB&lt;br&gt;Amazon Aurora" style="whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n-private">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-cache" value="Session cache&lt;br&gt;Amazon ElastiCache" style="whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="n-private">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-orders-queue" value="Orders queue&lt;br&gt;Amazon SQS" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-worker" value="Order worker&lt;br&gt;AWS Lambda" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n-payments" value="Payment provider" style="whiteSpace=wrap;html=1;rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="10" y="20" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-e1" value="https" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-customer" target="n-cdn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e2" value="https" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-cdn" target="n-assets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e3" value="https" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-cdn" target="n-alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e4" value="http" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-alb" target="n-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e5" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-api" target="n-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e6" value="tcp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-api" target="n-cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e7" value="amqp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n-api" target="n-orders-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e8" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="n-orders-queue" target="n-worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e9" value="sql" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-worker" target="n-db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-e10" value="https" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="n-worker" target="n-payments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>"
`;
