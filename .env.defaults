# Defaults for local development, shared by the frontend and the backend.
# Nothing secret goes here: this file is committed. Secrets go in .env.secrets,
# which git ignores (copy .env.secrets.example). The values of .env.secrets win.

# Frontend: where the API of the assistant runs locally. Only `make run` reads it;
# the build on GitHub Pages takes the API_URL variable of the repository instead.
VITE_API_URL=http://localhost:8787

# Backend: an OpenAI-compatible provider (Groq). It is only used when .env.secrets
# has LLM_API_KEY; without a key the API uses Workers AI of the Cloudflare account
# Wrangler is logged in to.
LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# How much a reasoning model thinks before it answers: low (default for gpt-oss), medium or high.
# LLM_REASONING_EFFORT=low
